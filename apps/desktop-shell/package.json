{
  "name": "ai-secretary-desktop",
  "version": "0.1.0",
  "description": "Local-first AI secretary desktop application with explicit Codex task approval.",
  "author": "VAIZO",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis",
    "lint": "node --check main.cjs && node --check preload.cjs"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "jp.vaizo.ai-secretary",
    "productName": "AI Secretary",
    "asar": true,
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [{ "from": "../ui/out", "to": "ui", "filter": ["**/*"] }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "publish": [{ "provider": "github", "owner": "r-sakurai-vaizo", "repo": "ai-secretary-releases" }]
  }
}
